# Platform-provided persistent workspace.
COMPETITION_WORKSPACE=/2026aicompetition/workspace

# Obtain the complete value from the competition container page.
COMPETITION_CALLBACK_URL=http://platform/api/competition/inference/callback/

# Keep one worker until real models are proven safe for concurrent GPU use.
COMPETITION_MAX_WORKERS=1
COMPETITION_CALLBACK_TIMEOUT=10
COMPETITION_CALLBACK_ATTEMPTS=3

# Optional real-plugin entry point. Omit to run the format-correct Dummy baseline.
#
# Track-4 self-built model group (glioma_track4 algorithm project):
#   COMPETITION_PIPELINE_FACTORY=tasks.glioma.pipeline:build_pipeline
#
# Roll out one plugin at a time by whitelisting goals; others stay on Dummy:
#   GLIOMA_GOALS=goal5
#   GLIOMA_GOALS=goal1,goal2_stitched,goal3,goal5,goal4,goal2_duplicate
#
# Weights resolve from $GLIOMA_CKPT, or /2026aicompetition/workspace/checkpoint/<goal>/
#   GLIOMA_CKPT=/2026aicompetition/workspace/checkpoint/goal5_segmentation/g4_fold0.pt,g4_fold1.pt
#
# Algorithm project location (auto-detected next to this repo if unset):
#   GLIOMA_TRACK4_ROOT=/2026aicompetition/workspace/glioma_track4
#
# NOTE: keep the line below commented until weights are exported and verified,
# otherwise the service will fail at startup instead of falling back to Dummy.
# COMPETITION_PIPELINE_FACTORY=tasks.glioma.pipeline:build_pipeline
